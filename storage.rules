rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{uid} {
      // Public read is required: Gmail (and every other email client) fetches
      // the <img src="..."> directly, with no Firebase Auth session attached.
      // If this were locked to request.auth, photos would show as broken
      // images in every signature.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
